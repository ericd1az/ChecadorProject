{
  "expo": {
    "name": "Hotel Display TV",
    "slug": "hotel-display-tv",
    "version": "1.0.0",
    "orientation": "landscape",
    "userInterfaceStyle": "dark",
    "android": {
      "package": "com.hotelproject.displaytv",
      "permissions": [
        "INTERNET"
      ]
    },
    "plugins": [
      [
        "@react-native-tvos/config-tv",
        {
          "isTV": true,
          "androidTVBanner": "assets/tv-banner.png"
        }
      ],
      "expo-sqlite",
      "expo-video"
    ]
  }
}
